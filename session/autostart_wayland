#!/bin/sh
set -eu

# Labwc runs this through sh. Keep it POSIX; consumers own only this hook.
if [ -n "${PELAGIAN_SHELL_SESSION_SENTINEL:-}" ]; then
    umask 077
    : > "${PELAGIAN_SHELL_SESSION_SENTINEL}"
fi

layoutd=/usr/local/bin/pelagian-layoutd
consumer_hook=/usr/local/bin/pelagian-shell-consumer
state_dir=${XDG_STATE_HOME:-/config/.local/state}/pelagian-shell
if [ -x "$layoutd" ] || [ -x "$consumer_hook" ]; then
    umask 077
    mkdir -p "$state_dir"
fi

if [ -x "$layoutd" ]; then
    rm -f "$state_dir/layoutd.exit"
    (
        set +e
        "$layoutd" >> "$state_dir/layoutd.log" 2>&1 &
        layoutd_pid=$!
        printf '%s\n' "$layoutd_pid" > "$state_dir/layoutd.pid"
        wait "$layoutd_pid"
        printf '%s\n' "$?" > "$state_dir/layoutd.exit"
    ) &
fi

if [ -x "$consumer_hook" ]; then
    rm -f "$state_dir/consumer.status"
    (
        set +e
        "$consumer_hook" >> "$state_dir/consumer.log" 2>&1 &
        consumer_pid=$!
        printf '%s\n' "$consumer_pid" > "$state_dir/consumer.pid"
        wait "$consumer_pid"
        printf '%s\n' "$?" > "$state_dir/consumer.status"
    ) &
fi
