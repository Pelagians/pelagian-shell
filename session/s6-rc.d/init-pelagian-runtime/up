#!/usr/bin/with-contenv bash
set -Eeuo pipefail

runtime_dir=/run/pelagian-shell
environment_dir=/run/s6/container_environment

# Run after LinuxServer's user remapping, before either the Wayland producer
# or desktop service starts. /run is container-local; never store session IPC
# in the persistent /config volume.
install -d -o abc -g abc -m 0700 "$runtime_dir"
find "$runtime_dir" -mindepth 1 -maxdepth 1 -exec rm -rf -- {} +
chown abc:abc "$runtime_dir"
chmod 0700 "$runtime_dir"

# The image ENV is the early default. Publish the Shell policy through s6's
# environment directory as well so every with-contenv service sees the same
# value, even when inherited LinuxServer defaults target /config/.XDG.
install -d -m 0755 "$environment_dir"
printf '%s\n' "$runtime_dir" > "$environment_dir/XDG_RUNTIME_DIR"
printf '%s\n' server > "$environment_dir/PELAGIAN_SHELL_WINDOW_CHROME"
